# FitAcademie Squash Webapp - Environment Variables
# Copy to .env and fill in

# Encryption key for Fernet (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=

# JWT Secret for session tokens
JWT_SECRET=change-this-in-production

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# FitAcademie portal
FITACADEMIE_BASE_URL=https://portaal.fitacademie.nl/club_portal/lessons

# Server
HOST=0.0.0.0
PORT=8000

# Scheduler
SCHEDULER_TIMEZONE=Europe/Amsterdam
SCHEDULER_RUN_TIME=06:00

# Frontend
FRONTEND_DIR=../frontend